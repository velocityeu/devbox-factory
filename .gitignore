# Logs folder - keep README, ignore log files
log/*.log
!log/README.md

# Legacy log locations
*.log
VibeDev-Install.log
DevBox-Install.log

# Temp folder - keep README, ignore everything else
temp/*
!temp/README.md

# Claude Code local config
.claude/

# Windows
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
*.vhdx

# ISO files (large, user-provided)
iso/*.iso
*.iso

# Pre-downloaded dependencies (large installer files)
# Keep manifest.json and README.md, ignore actual installers
dependencies/*.exe
dependencies/*.msi
dependencies/*.zip
dependencies/*.msix
!dependencies/manifest.json
!dependencies/README.md
!dependencies/.gitkeep

# Asset registry (local machine state)
config/asset-registry.json

# HyperV folder (VMs and templates created locally)
HyperV/
